{
  "name": "talentiq-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --import tsx/esm dist/src/index.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:studio": "prisma studio",
    "sqlite:schema": "node scripts/gen-sqlite-schema.mjs",
    "db:dev:generate": "npm run sqlite:schema && prisma generate --schema prisma/schema.sqlite.prisma",
    "db:dev:push": "npm run sqlite:schema && prisma db push --schema prisma/schema.sqlite.prisma",
    "db:dev:setup": "npm run db:dev:generate && npm run db:dev:push && npm run seed",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "db:setup": "prisma migrate deploy && tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1"
  }
}
