generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Candidate {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  avatar          String?
  role            String   @default("candidate")
  title           String?
  location        String?
  bio             String?

  githubConnected Boolean  @default(false)

  talentScore     Float?
  githubScore     Float?
  hackathonScore  Float?
  certScore       Float?
  presentationScore Float?
  openSourceScore Float?
  socialScore     Float?
  resumeScore     Float?
  interviewScore  Float?
  status          String?

  // Talent Intelligence Engine outputs
  technicalScore    Float?
  innovationScore   Float?
  leadershipScore   Float?
  growthScore       Float?
  learningScore     Float?
  riskScore         Float?
  authenticityScore Float?
  scoredAt          DateTime?

  radarData       String?
  signals         String?

  githubConnection GithubConnection?
  linkedInConnection LinkedInConnection?
  evidence        Evidence[]
  profile CandidateProfile?
  roadmapItems RoadmapItem[]
  resumes Resume[]
  applications JobApplication[]
  attachments Attachment[]
  auditLogs AuditLog[]
  badges Badge[]
  verificationRuns VerificationRun[]
  user User?
  agentRuns AgentRun[]
  skills CandidateSkill[]
  interviewSessions InterviewSession[]
  pipelineEntries PipelineEntry[]
  fraudFlags FraudFlag[]
  embedding CandidateEmbedding?
  careerSnapshots CareerSnapshot[]
  graphNodes GraphNode[]
  researchArtifacts ResearchArtifact[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum Visibility {
  PRIVATE
  RECRUITERS
  PUBLIC
}
enum EvidenceStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}
enum VerificationDecision {
  VERIFIED
  REJECTED
}
enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
  IGNORED
}
enum AttachmentScanStatus {
  PENDING
  CLEAN
  FAILED
  QUARANTINED
}

model CandidateProfile {
 id String @id @default(cuid())
 candidateId String @unique
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 headline String?
 phone String?
 website String?
 visibility Visibility @default(RECRUITERS)
 publishedAt DateTime?
 draftJson String?
 projectsJson String?
 credentialsJson String?
 workHistoryJson String?
 links CandidateLink[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model CandidateLink {
 id String @id @default(cuid())
 profileId String
 profile CandidateProfile @relation(fields:[profileId], references:[id], onDelete:Cascade)
 label String
 url String
 provider String?
 isPublic Boolean @default(true)
 syncStatus String @default("manual")
 lastSyncedAt DateTime?
 @@unique([profileId,url])
}
model RoadmapItem {
 id String @id @default(cuid())
 candidateId String
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 title String
 description String?
 dueAt DateTime?
 completedAt DateTime?
 position Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([candidateId,position])
}
model Resume {
 id String @id @default(cuid())
 candidateId String
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 name String
 template String @default("modern")
 activeVersionId String?
 versions ResumeVersion[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([candidateId,updatedAt])
}
model ResumeVersion {
 id String @id @default(cuid())
 resumeId String
 resume Resume @relation(fields:[resumeId], references:[id], onDelete:Cascade)
 version Int
 contentJson String
 attachmentId String?
 createdAt DateTime @default(now())
 @@unique([resumeId,version])
}
model Job {
 id String @id @default(cuid())
 title String
 company String
 location String?
 description String?
 applyUrl String?
 isActive Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 applications JobApplication[]

 companyId String?
 companyRef Company? @relation(fields:[companyId], references:[id], onDelete:SetNull)
 postedById String?
 postedBy RecruiterProfile? @relation(fields:[postedById], references:[id], onDelete:SetNull)

 skillsJson String @default("[]")
 responsibilitiesJson String @default("[]")
 seniority String?
 employmentType String?
 remote Boolean @default(false)
 salaryMin Int?
 salaryMax Int?
 currency String @default("INR")
 minTalentScore Int?
 closesAt DateTime?

 pipelineEntries PipelineEntry[]
 interviewSessions InterviewSession[]

 @@index([isActive,createdAt])
 @@index([companyId,isActive])
}
model JobApplication {
 id String @id @default(cuid())
 candidateId String
 jobId String
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 job Job @relation(fields:[jobId], references:[id], onDelete:Cascade)
 status ApplicationStatus @default(SAVED)
 notes String?
 historyJson String @default("[]")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([candidateId,jobId])
 @@index([candidateId,status,updatedAt])
}
model Evidence {
  id              String    @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  source          String
  provider        String?
  title           String
  issuer          String?
  referenceUrl    String?
  referenceId     String?
  issuedAt        DateTime?
  submittedAt     DateTime  @default(now())
  verifiedAt      DateTime?
  status          EvidenceStatus @default(DRAFT)
  score           Float?
  metadata        String?
  description String?
  visibility Visibility @default(PRIVATE)
  expiresAt DateTime?
  submittedBy String?
  reviews EvidenceReview[]
  attachments Attachment[]
  verificationRuns VerificationRun[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([candidateId, status])
  @@index([source, status])
}

model EvidenceReview {
 id String @id @default(cuid())
 evidenceId String
 evidence Evidence @relation(fields:[evidenceId], references:[id], onDelete:Cascade)
 reviewerId String
 reviewerName String?
 decision VerificationDecision
 reason String?
 score Float?
 createdAt DateTime @default(now())
 @@index([evidenceId,createdAt])
 @@index([reviewerId,createdAt])
}
model VerificationRun {
 id String @id @default(cuid())
 candidateId String
 evidenceId String?
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 evidence Evidence? @relation(fields:[evidenceId], references:[id], onDelete:SetNull)
 source String
 status String @default("queued")
 requestedAt DateTime @default(now())
 completedAt DateTime?
 detail String?
 @@index([candidateId,status])
}
model Attachment {
 id String @id @default(cuid())
 candidateId String
 evidenceId String?
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 evidence Evidence? @relation(fields:[evidenceId], references:[id], onDelete:SetNull)
 storageKey String @unique
 originalName String
 contentType String
 sizeBytes Int
 scanStatus AttachmentScanStatus @default(PENDING)
 scanDetail String?
 uploadedAt DateTime?
 createdAt DateTime @default(now())
 @@index([candidateId,createdAt])
 @@index([evidenceId])
}
model Badge {
 id String @id @default(cuid())
 candidateId String
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 label String
 description String?
 awardedAt DateTime @default(now())
 expiresAt DateTime?
 @@index([candidateId,awardedAt])
}
model AuditLog {
 id String @id @default(cuid())
 candidateId String?
 candidate Candidate? @relation(fields:[candidateId], references:[id], onDelete:SetNull)
 actorId String
 action String
 entityType String
 entityId String
 detail String?
 createdAt DateTime @default(now())
 @@index([candidateId,createdAt])
 @@index([entityType,entityId,createdAt])
}
model LinkedInConnection {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  linkedInId      String   @unique
  accessToken     String
  tokenExpiresAt  DateTime?
  name            String?
  email           String?
  avatarUrl       String?
  locale          String?
  connectedAt     DateTime @default(now())
  lastSyncedAt    DateTime?
  syncStatus      String   @default("pending")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GithubConnection {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  githubUsername   String
  githubId         Int?
  accessToken      String
  refreshToken     String?
  tokenExpiresAt   DateTime?

  avatarUrl       String?
  name            String?
  bio             String?
  company         String?
  location        String?
  publicRepos     Int?
  followers       Int?
  following       Int?

  connectedAt     DateTime @default(now())
  lastSyncedAt    DateTime?
  syncStatus      String   @default("pending")

  repos           GithubRepo[]
  languageSummary GithubLanguageSummary[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GithubRepo {
  id                 String   @id @default(cuid())
  githubConnectionId String
  connection         GithubConnection @relation(fields: [githubConnectionId], references: [id], onDelete: Cascade)

  githubId           Int      @unique
  name               String
  fullName           String
  description        String?
  url                String
  homepage           String?

  language           String?
  topics             String?

  stars              Int      @default(0)
  forks              Int      @default(0)
  openIssues         Int      @default(0)
  size               Int      @default(0)

  isFork             Boolean  @default(false)
  isArchived         Boolean  @default(false)
  isPrivate          Boolean  @default(false)

  pushedAt           DateTime?
  repoCreatedAt      DateTime?
  repoUpdatedAt      DateTime?

  commits            GithubCommit[]
  languages          GithubRepoLanguage[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model GithubCommit {
  id          String   @id @default(cuid())
  repoId      String
  repo        GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  sha         String
  message     String
  authorName  String?
  authorEmail String?

  committedAt DateTime
  additions   Int?
  deletions   Int?

  createdAt   DateTime @default(now())

  @@unique([repoId, sha])
}

model GithubRepoLanguage {
  id       String @id @default(cuid())
  repoId   String
  repo     GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  language String
  bytes    Int
  percentage Float?

  @@unique([repoId, language])
}

model GithubLanguageSummary {
  id                 String @id @default(cuid())
  githubConnectionId String
  connection         GithubConnection @relation(fields: [githubConnectionId], references: [id], onDelete: Cascade)

  language           String
  totalBytes         Int
  percentage         Float?
  repoCount          Int

  @@unique([githubConnectionId, language])
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

enum UserRole {
  CANDIDATE
  RECRUITER
  REVIEWER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(CANDIDATE)
  mobile       String?
  education    String?
  experienceYears Int?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?

  candidateId  String?  @unique
  candidate    Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  recruiter    RecruiterProfile?
  refreshTokens RefreshToken[]
  notifications Notification[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  website   String?
  industry  String?
  size      String?
  location  String?
  about     String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recruiters RecruiterProfile[]
  jobs       Job[]
}

model RecruiterProfile {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs            Job[]
  pipelineEntries PipelineEntry[]
  savedSearches   SavedSearch[]
}

// ---------------------------------------------------------------------------
// Recruiter operations
// ---------------------------------------------------------------------------

enum PipelineStage {
  DISCOVERED
  SCREENED
  SHORTLISTED
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
  ON_HOLD
}

model PipelineEntry {
  id          String   @id @default(cuid())
  recruiterId String
  recruiter   RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  stage       PipelineStage @default(DISCOVERED)
  note        String?
  rating      Int?
  historyJson String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([recruiterId, candidateId, jobId])
  @@index([recruiterId, stage, updatedAt])
}

model SavedSearch {
  id          String   @id @default(cuid())
  recruiterId String
  recruiter   RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  name        String
  query       String
  filtersJson String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([recruiterId, createdAt])
}

// ---------------------------------------------------------------------------
// AI interview
// ---------------------------------------------------------------------------

enum InterviewType {
  TECHNICAL
  HR
  BEHAVIORAL
  MIXED
}

enum InterviewStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model InterviewSession {
  id          String   @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  type        InterviewType   @default(TECHNICAL)
  status      InterviewStatus @default(CREATED)
  engine      String          @default("deterministic")

  technicalScore     Float?
  communicationScore Float?
  confidenceScore    Float?
  problemSolvingScore Float?
  overallScore       Float?
  recommendation     String?
  summary            String?
  strengthsJson      String @default("[]")
  improvementsJson   String @default("[]")

  startedAt   DateTime @default(now())
  completedAt DateTime?

  questions InterviewQuestion[]

  @@index([candidateId, startedAt])
}

model InterviewQuestion {
  id        String @id @default(cuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  position  Int
  category  String
  prompt    String
  difficulty String @default("medium")
  expectedSignalsJson String @default("[]")

  answerText  String?
  answeredAt  DateTime?
  score       Float?
  feedback    String?
  analysisJson String?

  @@unique([sessionId, position])
}

// ---------------------------------------------------------------------------
// Multi-agent intelligence
// ---------------------------------------------------------------------------

model AgentRun {
  id          String   @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  agent       String
  status      String   @default("running")
  engine      String   @default("deterministic")
  score       Float?
  confidence  Float?
  outputJson  String?
  error       String?
  durationMs  Int?

  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@index([candidateId, agent, startedAt])
}

model Skill {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  category String @default("general")
  aliasesJson String @default("[]")

  candidateSkills CandidateSkill[]
}

model CandidateSkill {
  id          String @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  level         Float   @default(0)
  evidenceCount Int     @default(0)
  verified      Boolean @default(false)
  sourcesJson   String  @default("[]")
  lastSeenAt    DateTime @default(now())

  @@unique([candidateId, skillId])
  @@index([skillId, level])
}

// ---------------------------------------------------------------------------
// Talent knowledge graph and reusable research layer
// ---------------------------------------------------------------------------

model GraphNode {
  id          String @id @default(cuid())
  type        String
  key         String
  label       String
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  propsJson   String @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outgoing GraphEdge[] @relation("GraphEdgeFrom")
  incoming GraphEdge[] @relation("GraphEdgeTo")

  @@unique([type, key])
  @@index([candidateId, type])
}

model GraphEdge {
  id        String @id @default(cuid())
  fromId    String
  from      GraphNode @relation("GraphEdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        GraphNode @relation("GraphEdgeTo", fields: [toId], references: [id], onDelete: Cascade)
  type      String
  weight    Float  @default(1)
  propsJson String @default("{}")
  createdAt DateTime @default(now())

  @@unique([fromId, toId, type])
  @@index([toId, type])
}

model CandidateEmbedding {
  id          String @id @default(cuid())
  candidateId String @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  model       String
  dims        Int
  vectorJson  String
  textHash    String
  updatedAt   DateTime @updatedAt
}

model ResearchArtifact {
  id          String @id @default(cuid())
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind        String
  key         String
  payloadJson String
  createdAt   DateTime @default(now())

  @@unique([kind, key])
  @@index([candidateId, kind])
}

model CareerSnapshot {
  id          String @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  capturedAt  DateTime @default(now())

  talentScore       Float?
  technicalScore    Float?
  innovationScore   Float?
  leadershipScore   Float?
  growthScore       Float?
  learningScore     Float?
  riskScore         Float?
  authenticityScore Float?
  signalsJson       String?

  @@index([candidateId, capturedAt])
}

// ---------------------------------------------------------------------------
// Trust and fraud
// ---------------------------------------------------------------------------

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model FraudFlag {
  id          String @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  evidenceId  String?

  type        String
  severity    FraudSeverity @default(LOW)
  status      FraudStatus   @default(OPEN)
  detail      String?
  signalsJson String  @default("[]")
  detectedBy  String  @default("system")
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([candidateId, type, evidenceId])
  @@index([candidateId, status])
  @@index([status, severity])
}

// ---------------------------------------------------------------------------
// Career intelligence support data
// ---------------------------------------------------------------------------

model Notification {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SalaryBenchmark {
  id         String @id @default(cuid())
  roleFamily String
  region     String
  seniority  String
  currency   String @default("INR")
  p25        Int
  p50        Int
  p75        Int
  source     String @default("internal")
  updatedAt  DateTime @updatedAt

  @@unique([roleFamily, region, seniority])
}

model LearningResource {
  id        String @id @default(cuid())
  skillSlug String
  title     String
  provider  String
  url       String
  level     String @default("intermediate")
  hours     Int?
  createdAt DateTime @default(now())

  @@unique([skillSlug, url])
  @@index([skillSlug])
}
