generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Candidate {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  avatar          String?
  role            String   @default("candidate")
  title           String?
  location        String?
  bio             String?

  githubConnected Boolean  @default(false)

  talentScore     Float?
  githubScore     Float?
  hackathonScore  Float?
  certScore       Float?
  presentationScore Float?
  openSourceScore Float?
  socialScore     Float?
  status          String?

  radarData       String?
  signals         String?

  githubConnection GithubConnection?
  linkedInConnection LinkedInConnection?
  evidence        Evidence[]
  profile CandidateProfile?
  roadmapItems RoadmapItem[]
  resumes Resume[]
  applications JobApplication[]
  attachments Attachment[]
  auditLogs AuditLog[]
  badges Badge[]
  verificationRuns VerificationRun[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum Visibility {
  PRIVATE
  RECRUITERS
  PUBLIC
}
enum EvidenceStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}
enum VerificationDecision {
  VERIFIED
  REJECTED
}
enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
  IGNORED
}
enum AttachmentScanStatus {
  PENDING
  CLEAN
  FAILED
  QUARANTINED
}

model CandidateProfile {
 id String @id @default(cuid())
 candidateId String @unique
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 headline String?
 phone String?
 website String?
 visibility Visibility @default(RECRUITERS)
 publishedAt DateTime?
 draftJson String?
 projectsJson String?
 credentialsJson String?
 workHistoryJson String?
 links CandidateLink[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model CandidateLink {
 id String @id @default(cuid())
 profileId String
 profile CandidateProfile @relation(fields:[profileId], references:[id], onDelete:Cascade)
 label String
 url String
 provider String?
 isPublic Boolean @default(true)
 syncStatus String @default("manual")
 lastSyncedAt DateTime?
 @@unique([profileId,url])
}
model RoadmapItem {
 id String @id @default(cuid())
 candidateId String
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 title String
 description String?
 dueAt DateTime?
 completedAt DateTime?
 position Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([candidateId,position])
}
model Resume {
 id String @id @default(cuid())
 candidateId String
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 name String
 template String @default("modern")
 activeVersionId String?
 versions ResumeVersion[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([candidateId,updatedAt])
}
model ResumeVersion {
 id String @id @default(cuid())
 resumeId String
 resume Resume @relation(fields:[resumeId], references:[id], onDelete:Cascade)
 version Int
 contentJson String
 attachmentId String?
 createdAt DateTime @default(now())
 @@unique([resumeId,version])
}
model Job {
 id String @id @default(cuid())
 title String
 company String
 location String?
 description String?
 applyUrl String?
 isActive Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 applications JobApplication[]
 @@index([isActive,createdAt])
}
model JobApplication {
 id String @id @default(cuid())
 candidateId String
 jobId String
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 job Job @relation(fields:[jobId], references:[id], onDelete:Cascade)
 status ApplicationStatus @default(SAVED)
 notes String?
 historyJson String @default("[]")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([candidateId,jobId])
 @@index([candidateId,status,updatedAt])
}
model Evidence {
  id              String    @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  source          String
  provider        String?
  title           String
  issuer          String?
  referenceUrl    String?
  referenceId     String?
  issuedAt        DateTime?
  submittedAt     DateTime  @default(now())
  verifiedAt      DateTime?
  status          EvidenceStatus @default(DRAFT)
  score           Float?
  metadata        String?
  description String?
  visibility Visibility @default(PRIVATE)
  expiresAt DateTime?
  submittedBy String?
  reviews EvidenceReview[]
  attachments Attachment[]
  verificationRuns VerificationRun[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([candidateId, status])
  @@index([source, status])
}

model EvidenceReview {
 id String @id @default(cuid())
 evidenceId String
 evidence Evidence @relation(fields:[evidenceId], references:[id], onDelete:Cascade)
 reviewerId String
 reviewerName String?
 decision VerificationDecision
 reason String?
 score Float?
 createdAt DateTime @default(now())
 @@index([evidenceId,createdAt])
 @@index([reviewerId,createdAt])
}
model VerificationRun {
 id String @id @default(cuid())
 candidateId String
 evidenceId String?
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 evidence Evidence? @relation(fields:[evidenceId], references:[id], onDelete:SetNull)
 source String
 status String @default("queued")
 requestedAt DateTime @default(now())
 completedAt DateTime?
 detail String?
 @@index([candidateId,status])
}
model Attachment {
 id String @id @default(cuid())
 candidateId String
 evidenceId String?
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 evidence Evidence? @relation(fields:[evidenceId], references:[id], onDelete:SetNull)
 storageKey String @unique
 originalName String
 contentType String
 sizeBytes Int
 scanStatus AttachmentScanStatus @default(PENDING)
 scanDetail String?
 uploadedAt DateTime?
 createdAt DateTime @default(now())
 @@index([candidateId,createdAt])
 @@index([evidenceId])
}
model Badge {
 id String @id @default(cuid())
 candidateId String
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 label String
 description String?
 awardedAt DateTime @default(now())
 expiresAt DateTime?
 @@index([candidateId,awardedAt])
}
model AuditLog {
 id String @id @default(cuid())
 candidateId String?
 candidate Candidate? @relation(fields:[candidateId], references:[id], onDelete:SetNull)
 actorId String
 action String
 entityType String
 entityId String
 detail String?
 createdAt DateTime @default(now())
 @@index([candidateId,createdAt])
 @@index([entityType,entityId,createdAt])
}
model LinkedInConnection {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  linkedInId      String   @unique
  accessToken     String
  tokenExpiresAt  DateTime?
  name            String?
  email           String?
  avatarUrl       String?
  locale          String?
  connectedAt     DateTime @default(now())
  lastSyncedAt    DateTime?
  syncStatus      String   @default("pending")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GithubConnection {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  githubUsername   String
  githubId         Int?
  accessToken      String
  refreshToken     String?
  tokenExpiresAt   DateTime?

  avatarUrl       String?
  name            String?
  bio             String?
  company         String?
  location        String?
  publicRepos     Int?
  followers       Int?
  following       Int?

  connectedAt     DateTime @default(now())
  lastSyncedAt    DateTime?
  syncStatus      String   @default("pending")

  repos           GithubRepo[]
  languageSummary GithubLanguageSummary[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GithubRepo {
  id                 String   @id @default(cuid())
  githubConnectionId String
  connection         GithubConnection @relation(fields: [githubConnectionId], references: [id], onDelete: Cascade)

  githubId           Int      @unique
  name               String
  fullName           String
  description        String?
  url                String
  homepage           String?

  language           String?
  topics             String?

  stars              Int      @default(0)
  forks              Int      @default(0)
  openIssues         Int      @default(0)
  size               Int      @default(0)

  isFork             Boolean  @default(false)
  isArchived         Boolean  @default(false)
  isPrivate          Boolean  @default(false)

  pushedAt           DateTime?
  repoCreatedAt      DateTime?
  repoUpdatedAt      DateTime?

  commits            GithubCommit[]
  languages          GithubRepoLanguage[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model GithubCommit {
  id          String   @id @default(cuid())
  repoId      String
  repo        GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  sha         String
  message     String
  authorName  String?
  authorEmail String?

  committedAt DateTime
  additions   Int?
  deletions   Int?

  createdAt   DateTime @default(now())

  @@unique([repoId, sha])
}

model GithubRepoLanguage {
  id       String @id @default(cuid())
  repoId   String
  repo     GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  language String
  bytes    Int
  percentage Float?

  @@unique([repoId, language])
}

model GithubLanguageSummary {
  id                 String @id @default(cuid())
  githubConnectionId String
  connection         GithubConnection @relation(fields: [githubConnectionId], references: [id], onDelete: Cascade)

  language           String
  totalBytes         Int
  percentage         Float?
  repoCount          Int

  @@unique([githubConnectionId, language])
}
