generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Candidate {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  avatar          String?
  role            String   @default("candidate")
  title           String?
  location        String?
  bio             String?

  githubConnected Boolean  @default(false)

  talentScore     Float?
  githubScore     Float?
  hackathonScore  Float?
  certScore       Float?
  presentationScore Float?
  openSourceScore Float?
  socialScore     Float?
  status          String?

  radarData       String?
  signals         String?

  githubConnection GithubConnection?

  userId           String?   @unique
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  orgCandidates    OrgCandidate[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GithubConnection {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  githubUsername   String
  githubId         Int?
  accessToken      String
  refreshToken     String?
  tokenExpiresAt   DateTime?

  avatarUrl       String?
  name            String?
  bio             String?
  company         String?
  location        String?
  publicRepos     Int?
  followers       Int?
  following       Int?

  connectedAt     DateTime @default(now())
  lastSyncedAt    DateTime?
  syncStatus      String   @default("pending")

  repos           GithubRepo[]
  languageSummary GithubLanguageSummary[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GithubRepo {
  id                 String   @id @default(cuid())
  githubConnectionId String
  connection         GithubConnection @relation(fields: [githubConnectionId], references: [id], onDelete: Cascade)

  githubId           Int      @unique
  name               String
  fullName           String
  description        String?
  url                String
  homepage           String?

  language           String?
  topics             String?

  stars              Int      @default(0)
  forks              Int      @default(0)
  openIssues         Int      @default(0)
  size               Int      @default(0)

  isFork             Boolean  @default(false)
  isArchived         Boolean  @default(false)
  isPrivate          Boolean  @default(false)

  pushedAt           DateTime?
  repoCreatedAt      DateTime?
  repoUpdatedAt      DateTime?

  commits            GithubCommit[]
  languages          GithubRepoLanguage[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model GithubCommit {
  id          String   @id @default(cuid())
  repoId      String
  repo        GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  sha         String
  message     String
  authorName  String?
  authorEmail String?

  committedAt DateTime
  additions   Int?
  deletions   Int?

  createdAt   DateTime @default(now())

  @@unique([repoId, sha])
}

model GithubRepoLanguage {
  id       String @id @default(cuid())
  repoId   String
  repo     GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  language String
  bytes    Int
  percentage Float?

  @@unique([repoId, language])
}

model GithubLanguageSummary {
  id                 String @id @default(cuid())
  githubConnectionId String
  connection         GithubConnection @relation(fields: [githubConnectionId], references: [id], onDelete: Cascade)

  language           String
  totalBytes         Int
  percentage         Float?
  repoCount          Int

  @@unique([githubConnectionId, language])
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  role            String   @default("CANDIDATE") // CANDIDATE, RECRUITER, ADMIN
  name            String
  avatar          String?
  emailVerified   Boolean  @default(false)
  status          String   @default("ACTIVE") // ACTIVE, SUSPENDED, DELETED
  lastLoginAt     DateTime?

  candidate       Candidate?
  refreshTokens   RefreshToken[]
  resetTokens     PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  orgMemberships  OrganizationMember[]
  consentRecords  ConsentRecord[]
  privacyPref     PrivacyPreference?
  deletionRequest DeletionRequest?
  auditLogs       AuditLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RefreshToken {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash          String   @unique
  expiresAt          DateTime
  isRevoked          Boolean  @default(false)
  replacedByTokenHash String?
  ipAddress          String?
  userAgent          String?

  createdAt          DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  members        OrganizationMember[]
  orgCandidates  OrgCandidate[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // ADMIN, MEMBER

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
}

model OrgCandidate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status         String       @default("Discovered") // Discovered, Screened, Interviewing, Offered, Hired
  addedByUserId  String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, candidateId])
}

model ConsentRecord {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType String    // e.g. "AI_EVALUATION", "PUBLIC_SHARING", "BACKGROUND_VERIFY"
  status      String    @default("GRANTED") // GRANTED, REVOKED
  version     String    @default("1.0")
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@unique([userId, consentType])
}

model PrivacyPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  visibility  String   @default("ORGANIZATION_SHARED") // PRIVATE, ORGANIZATION_SHARED, PUBLIC_PROFILE

  createdAt   DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DeletionRequest {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, CANCELLED
  requestedAt DateTime  @default(now())
  processedAt DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  userAgent String?
  metadata  String?

  createdAt DateTime @default(now())
}