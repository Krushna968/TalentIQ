generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Candidate {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  avatar          String?
  role            String   @default("candidate")
  title           String?
  location        String?
  bio             String?

  githubConnected Boolean  @default(false)

  talentScore     Float?
  githubScore     Float?
  hackathonScore  Float?
  certScore       Float?
  presentationScore Float?
  openSourceScore Float?
  socialScore     Float?
  status          String?

  radarData       String?
  signals         String?

  githubConnection GithubConnection?
  linkedInConnection LinkedInConnection?
  evidence        Evidence[]
  profile CandidateProfile?
  roadmapItems RoadmapItem[]
  resumes Resume[]
  applications JobApplication[]
  attachments Attachment[]
  auditLogs AuditLog[]
  badges Badge[]
  verificationRuns VerificationRun[]
  pipelineEntries PipelineEntry[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum Visibility {
  PRIVATE
  RECRUITERS
  PUBLIC
}
enum EvidenceStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}
enum VerificationDecision {
  VERIFIED
  REJECTED
}
enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
  IGNORED
}
enum AttachmentScanStatus {
  PENDING
  CLEAN
  FAILED
  QUARANTINED
}

model CandidateProfile {
 id String @id @default(cuid())
 candidateId String @unique
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 headline String?
 phone String?
 website String?
 visibility Visibility @default(RECRUITERS)
 publishedAt DateTime?
 draftJson String?
 projectsJson String?
 credentialsJson String?
 workHistoryJson String?
 links CandidateLink[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model CandidateLink {
 id String @id @default(cuid())
 profileId String
 profile CandidateProfile @relation(fields:[profileId], references:[id], onDelete:Cascade)
 label String
 url String
 provider String?
 isPublic Boolean @default(true)
 syncStatus String @default("manual")
 lastSyncedAt DateTime?
 @@unique([profileId,url])
}
model RoadmapItem {
 id String @id @default(cuid())
 candidateId String
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 title String
 description String?
 dueAt DateTime?
 completedAt DateTime?
 position Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([candidateId,position])
}
model Resume {
 id String @id @default(cuid())
 candidateId String
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 name String
 template String @default("modern")
 activeVersionId String?
 versions ResumeVersion[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([candidateId,updatedAt])
}
model ResumeVersion {
 id String @id @default(cuid())
 resumeId String
 resume Resume @relation(fields:[resumeId], references:[id], onDelete:Cascade)
 version Int
 contentJson String
 attachmentId String?
 createdAt DateTime @default(now())
 @@unique([resumeId,version])
}
model Job {
 id String @id @default(cuid())
 title String
 company String
 location String?
 description String?
 applyUrl String?
 isActive Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 applications JobApplication[]
 @@index([isActive,createdAt])
}
model JobApplication {
 id String @id @default(cuid())
 candidateId String
 jobId String
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 job Job @relation(fields:[jobId], references:[id], onDelete:Cascade)
 status ApplicationStatus @default(SAVED)
 notes String?
 historyJson String @default("[]")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([candidateId,jobId])
 @@index([candidateId,status,updatedAt])
}
model Evidence {
  id              String    @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  source          String
  provider        String?
  title           String
  issuer          String?
  referenceUrl    String?
  referenceId     String?
  issuedAt        DateTime?
  submittedAt     DateTime  @default(now())
  verifiedAt      DateTime?
  status          EvidenceStatus @default(DRAFT)
  score           Float?
  metadata        String?
  description String?
  visibility Visibility @default(PRIVATE)
  expiresAt DateTime?
  submittedBy String?
  reviews EvidenceReview[]
  attachments Attachment[]
  verificationRuns VerificationRun[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([candidateId, status])
  @@index([source, status])
}

model EvidenceReview {
 id String @id @default(cuid())
 evidenceId String
 evidence Evidence @relation(fields:[evidenceId], references:[id], onDelete:Cascade)
 reviewerId String
 reviewerName String?
 decision VerificationDecision
 reason String?
 score Float?
 createdAt DateTime @default(now())
 @@index([evidenceId,createdAt])
 @@index([reviewerId,createdAt])
}
model VerificationRun {
 id String @id @default(cuid())
 candidateId String
 evidenceId String?
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 evidence Evidence? @relation(fields:[evidenceId], references:[id], onDelete:SetNull)
 source String
 status String @default("queued")
 requestedAt DateTime @default(now())
 completedAt DateTime?
 detail String?
 @@index([candidateId,status])
}
model Attachment {
 id String @id @default(cuid())
 candidateId String
 evidenceId String?
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 evidence Evidence? @relation(fields:[evidenceId], references:[id], onDelete:SetNull)
 storageKey String @unique
 originalName String
 contentType String
 sizeBytes Int
 scanStatus AttachmentScanStatus @default(PENDING)
 scanDetail String?
 uploadedAt DateTime?
 createdAt DateTime @default(now())
 @@index([candidateId,createdAt])
 @@index([evidenceId])
}
model Badge {
 id String @id @default(cuid())
 candidateId String
 candidate Candidate @relation(fields:[candidateId], references:[id], onDelete:Cascade)
 label String
 description String?
 awardedAt DateTime @default(now())
 expiresAt DateTime?
 @@index([candidateId,awardedAt])
}
model AuditLog {
 id String @id @default(cuid())
 candidateId String?
 candidate Candidate? @relation(fields:[candidateId], references:[id], onDelete:SetNull)
 actorId String
 action String
 entityType String
 entityId String
 detail String?
 createdAt DateTime @default(now())
 @@index([candidateId,createdAt])
 @@index([entityType,entityId,createdAt])
}
model LinkedInConnection {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  linkedInId      String   @unique
  accessToken     String
  tokenExpiresAt  DateTime?
  name            String?
  email           String?
  avatarUrl       String?
  locale          String?
  connectedAt     DateTime @default(now())
  lastSyncedAt    DateTime?
  syncStatus      String   @default("pending")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GithubConnection {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  githubUsername   String
  githubId         Int?
  accessToken      String
  refreshToken     String?
  tokenExpiresAt   DateTime?

  avatarUrl       String?
  name            String?
  bio             String?
  company         String?
  location        String?
  publicRepos     Int?
  followers       Int?
  following       Int?

  connectedAt     DateTime @default(now())
  lastSyncedAt    DateTime?
  syncStatus      String   @default("pending")

  repos           GithubRepo[]
  languageSummary GithubLanguageSummary[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GithubRepo {
  id                 String   @id @default(cuid())
  githubConnectionId String
  connection         GithubConnection @relation(fields: [githubConnectionId], references: [id], onDelete: Cascade)

  githubId           Int      @unique
  name               String
  fullName           String
  description        String?
  url                String
  homepage           String?

  language           String?
  topics             String?

  stars              Int      @default(0)
  forks              Int      @default(0)
  openIssues         Int      @default(0)
  size               Int      @default(0)

  isFork             Boolean  @default(false)
  isArchived         Boolean  @default(false)
  isPrivate          Boolean  @default(false)

  pushedAt           DateTime?
  repoCreatedAt      DateTime?
  repoUpdatedAt      DateTime?

  commits            GithubCommit[]
  languages          GithubRepoLanguage[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model GithubCommit {
  id          String   @id @default(cuid())
  repoId      String
  repo        GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  sha         String
  message     String
  authorName  String?
  authorEmail String?

  committedAt DateTime
  additions   Int?
  deletions   Int?

  createdAt   DateTime @default(now())

  @@unique([repoId, sha])
}

model GithubRepoLanguage {
  id       String @id @default(cuid())
  repoId   String
  repo     GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  language String
  bytes    Int
  percentage Float?

  @@unique([repoId, language])
}

model GithubLanguageSummary {
  id                 String @id @default(cuid())
  githubConnectionId String
  connection         GithubConnection @relation(fields: [githubConnectionId], references: [id], onDelete: Cascade)

  language           String
  totalBytes         Int
  percentage         Float?
  repoCount          Int

  @@unique([githubConnectionId, language])
}

// ---------------------------------------------------------------------------
// Owner 3 — Recruiter Operations domain
// Multi-tenant recruiter workspace: organizations, requisitions, permissions,
// a persisted hiring pipeline, an immutable decision timeline, and audit trail.
// Enum-like fields use String to match the existing convention (e.g. Evidence.status).
// ---------------------------------------------------------------------------

// Tenant root. Every recruiter record hangs off exactly one Organization and
// all queries are scoped by orgId (see src/lib/tenant.ts).
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique

  members       Membership[]
  requisitions  Requisition[]
  auditLogs     RecruiterAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Org/team membership + recruiter role. userId references the identity owned by
// Owner 1's auth system; email/name are display snapshots (provisional).
model Membership {
  id     String @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  userId String
  email  String?
  name   String?
  role   String @default("recruiter") // owner | admin | recruiter | viewer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, userId])
  @@index([orgId, role])
}

// A recruiter hiring requisition (Owner 3). Named Requisition to avoid colliding
// with Owner 2's candidate-facing Job (job-board postings). These are distinct
// domains; a link between them can be added later via coordination with Owner 2.
model Requisition {
  id             String  @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title          String
  description    String?
  department     String?
  location       String?
  employmentType String? // full_time | part_time | contract | intern
  status         String  @default("draft")     // draft | open | closed
  visibility     String  @default("org")        // org | assigned
  createdById    String
  closedAt       DateTime?

  collaborators JobCollaborator[]
  stages        PipelineStage[]
  entries       PipelineEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
}

// Recruiter-to-requisition permission grant.
model JobCollaborator {
  id     String @id @default(cuid())
  jobId  String
  requisition Requisition @relation(fields: [jobId], references: [id], onDelete: Cascade)

  userId String
  role   String @default("viewer") // owner | editor | viewer

  createdAt DateTime @default(now())

  @@unique([jobId, userId])
  @@index([userId])
}

// A configurable pipeline stage belonging to a job. Terminal stages (Hired /
// Rejected) cannot be moved out of without an explicit reopen.
model PipelineStage {
  id         String @id @default(cuid())
  jobId      String
  requisition Requisition @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name       String
  order      Int
  isTerminal Boolean @default(false)

  entries    PipelineEntry[]

  createdAt DateTime @default(now())

  @@index([jobId, order])
}

// A candidate placed into a job's pipeline. Replaces the old in-memory
// AppContext status. updatedAt drives optimistic-concurrency checks.
model PipelineEntry {
  id               String @id @default(cuid())
  jobId            String
  requisition      Requisition @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId      String
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  currentStageId   String
  currentStage     PipelineStage @relation(fields: [currentStageId], references: [id])

  assignedToUserId String?
  shortlisted      Boolean @default(false)
  addedById        String

  events           PipelineEvent[]

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, candidateId])
  @@index([jobId, currentStageId])
}

// Append-only activity/decision timeline. The service layer never updates or
// deletes these rows — they are the immutable record of who changed what, when.
model PipelineEvent {
  id          String @id @default(cuid())
  entryId     String
  entry       PipelineEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  type        String  // added | stage_change | decision | assignment | note
  fromStageId String?
  toStageId   String?
  decision    String? // hire | hold | reject
  reason      String?
  body        String?
  actorId     String
  actorName   String?

  createdAt DateTime @default(now())

  @@index([entryId, createdAt])
}

// Tenant-scoped recruiter audit trail (Owner 3). Named RecruiterAuditLog to avoid
// colliding with Owner 2's candidate-scoped AuditLog. Every mutating recruiter
// action writes one row.
model RecruiterAuditLog {
  id         String @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  actorId    String
  actorName  String?
  action     String
  targetType String
  targetId   String
  metadata   String? // JSON string

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([targetType, targetId])
}
