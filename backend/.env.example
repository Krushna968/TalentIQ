# Server
PORT=4000
NODE_ENV=development

# Database (managed PostgreSQL in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Local Docker PostgreSQL only. Do not use this value in a deployed environment.
POSTGRES_USER=talentiq
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=talentiq

# Auth
# Required in production; use at least 32 random characters and store it in your secret manager.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Required in production. Use a separate 32+ character secret to encrypt stored OAuth tokens.
TOKEN_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret-at-least-32-characters

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Change this to your Render URL after deploy
GITHUB_CALLBACK_URL=https://YOUR_APP.onrender.com/api/auth/github/callback

# LinkedIn OAuth / OpenID Connect
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_CALLBACK_URL=https://YOUR_APP.onrender.com/api/auth/linkedin/callback

# Change this to your Netlify URL after deploy
FRONTEND_URL=https://YOUR_SITE.netlify.app
CORS_ORIGIN=https://YOUR_SITE.netlify.app

# Background workers (Redis)
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=talentiq
WORKER_CONCURRENCY=4

# Groq AI (server-only: never use VITE_ prefix)
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
